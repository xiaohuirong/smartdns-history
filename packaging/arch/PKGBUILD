# Maintainer: Hoream <hoream@qq.com>
_pkgname="smartdns-history"
pkgname="${_pkgname}-git"
pkgver=0.0.1 # Placeholder, will be overwritten by pkgver()
pkgrel=1
pkgdesc="A real-time web dashboard for visualizing SmartDNS audit logs."
url="https://github.com/xiaohuirong/smartdns-history"
license=("MIT")
arch=('x86_64')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
depends=('systemd') # For the systemd service file
makedepends=("cargo" "git")
source=("${_pkgname}::git+${url}.git") # Use .git suffix for source url
sha256sums=('SKIP')

prepare() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    # cargo fetch --locked --target "$CARCH-unknown-linux-gnu" # Use --locked only if Cargo.lock is committed
    cargo fetch --target "$CARCH-unknown-linux-gnu"
}

pkgver() {
  cd "${srcdir}/${_pkgname}"
  # Use a common pkgver format for VCS packages
  # This tries to use git tags, then falls back to rev-list count + short hash
  # Example: 0.1.0.r12.gabcdef
  if git describe --long --tags --abbrev=7 &>/dev/null; then
    git describe --long --tags --abbrev=7 | sed 's/\([^-]*\)-\([^-]*\)-\(g[0-9a-fA-F]*\)/r\2.\3/;s/^v//'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build(){
 	cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "${srcdir}/${_pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-features
}

package() {
	install -d "${pkgdir}/usr/bin"
	install -Dm755 "${srcdir}/${_pkgname}/target/release/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"
    
    # Install documentation
    install -d "${pkgdir}/usr/share/doc/${_pkgname}"
    install -Dm644 "${srcdir}/${_pkgname}/README.md" "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
    install -Dm644 "${srcdir}/${_pkgname}/GEMINI.md" "${pkgdir}/usr/share/doc/${_pkgname}/GEMINI.md"
    
    # Install systemd service file
    install -Dm644 "${srcdir}/${_pkgname}/packaging/arch/smartdns-history.service" "${pkgdir}/usr/lib/systemd/system/${_pkgname}.service"
    
    # Install license (if LICENSE file exists in repo root)
    # If the license content is embedded in README, this step can be skipped or README can be copied here.
    # For now, we assume MIT license info is in README and pkgbuild license field covers it.
}